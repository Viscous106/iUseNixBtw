(defcfg
  ;; 1. Device Selection
  ;; This targets both your laptop keyboard and USB keyboard
  linux-dev (
    /dev/input/by-path/platform-i8042-serio-0-event-kbd
    /dev/input/by-path/pci-0000:05:00.4-usb-0:2:1.0-event-kbd
  )
  process-unmapped-keys yes
)

;; 2. Source Keys (The physical keys you want to change)
(defsrc
  caps
)

;; 3. Layer Definition (What those keys should do)
(deflayer base
  ;; Tap Caps Lock -> Escape
  ;; Hold Caps Lock -> Left Control
  @cap
)

;; 4. Aliases (Shortcuts for complex actions)
(defalias
  cap (tap-hold 100 100 esc lctl)
)
