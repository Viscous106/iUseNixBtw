{
  "model": "opus[1m]",
  "statusLine": {
    "type": "command",
    "command": "/home/viscous/.config/claude/helpers/statusline.sh",
    "refreshInterval": 5
  },
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": true,
    "superpowers@claude-plugins-official": true,
    "rust-analyzer-lsp@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true
  },
  "tui": "fullscreen",
  "voice": {
    "enabled": true,
    "mode": "hold"
  },
  "skipDangerousModePermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "theme": "dark",
  "voiceEnabled": true,
  "hooks": {
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/home/viscous/.config/claude/hooks/claude-notify.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/home/viscous/.config/claude/hooks/claude-notify.sh",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
