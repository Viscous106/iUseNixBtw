{
  "permissions": {
    "allow": [
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git ls-files *)",
      "Bash(git blame *)",
      "Bash(git describe *)",
      "Bash(git shortlog *)",
      "Bash(git rev-parse *)",
      "Bash(git branch --list *)",
      "Bash(git remote -v *)",
      "Bash(git config --get *)",
      "Bash(cargo check *)",
      "Bash(cargo test *)",
      "Bash(cargo clippy *)",
      "Bash(cargo fmt *)",
      "Bash(cargo build *)",
      "Bash(cargo tree *)",
      "Bash(rg *)",
      "Bash(fd *)",
      "Bash(jq *)",
      "Bash(tree *)",
      "Bash(npm test *)",
      "Bash(npm run lint *)",
      "Bash(npm run build *)",
      "Bash(pnpm test *)",
      "Bash(pnpm lint *)",
      "Bash(pnpm build *)",
      "Bash(nix flake check *)",
      "Bash(nix flake show *)",
      "Bash(nix eval *)",
      "Bash(nix fmt *)"
    ],
    "deny": [
      "Read(//**/.env)",
      "Read(//**/.env.*)",
      "Read(//**/*.pem)",
      "Read(//**/*.key)",
      "Read(//**/id_rsa*)",
      "Read(//**/id_ed25519*)",
      "Read(//**/*.age)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.gnupg/**)",
      "Read(~/.config/gh/hosts.yml)",
      "Bash(git add *)",
      "Bash(git * add *)",
      "Bash(config add *)",
      "Bash(git am *)",
      "Bash(git * am *)",
      "Bash(config am *)",
      "Bash(git apply *)",
      "Bash(git * apply *)",
      "Bash(config apply *)",
      "Bash(git cherry-pick *)",
      "Bash(git * cherry-pick *)",
      "Bash(config cherry-pick *)",
      "Bash(git clean *)",
      "Bash(git * clean *)",
      "Bash(config clean *)",
      "Bash(git commit *)",
      "Bash(git * commit *)",
      "Bash(config commit *)",
      "Bash(git checkout *)",
      "Bash(git * checkout *)",
      "Bash(config checkout *)",
      "Bash(git switch *)",
      "Bash(git * switch *)",
      "Bash(config switch *)",
      "Bash(git merge *)",
      "Bash(git * merge *)",
      "Bash(config merge *)",
      "Bash(git mv *)",
      "Bash(git * mv *)",
      "Bash(config mv *)",
      "Bash(git pull *)",
      "Bash(git * pull *)",
      "Bash(config pull *)",
      "Bash(git push *)",
      "Bash(git * push *)",
      "Bash(config push *)",
      "Bash(git rebase *)",
      "Bash(git * rebase *)",
      "Bash(config rebase *)",
      "Bash(git reset *)",
      "Bash(git * reset *)",
      "Bash(config reset *)",
      "Bash(git restore *)",
      "Bash(git * restore *)",
      "Bash(config restore *)",
      "Bash(git revert *)",
      "Bash(git * revert *)",
      "Bash(config revert *)",
      "Bash(git rm *)",
      "Bash(git * rm *)",
      "Bash(config rm *)",
      "Bash(git stash *)",
      "Bash(git * stash *)",
      "Bash(config stash *)",
      "Bash(git tag *)",
      "Bash(git * tag *)",
      "Bash(config tag *)",
      "Bash(gh pr create *)",
      "Bash(gh pr merge *)",
      "Bash(gh pr close *)",
      "Bash(gh pr edit *)",
      "Bash(gh pr comment *)",
      "Bash(gh pr review *)",
      "Bash(gh pr ready *)",
      "Bash(gh release *)",
      "Bash(gh repo create *)",
      "Bash(gh repo delete *)",
      "Bash(gh repo rename *)",
      "Bash(gh repo fork *)",
      "Bash(gh repo archive *)",
      "Bash(gh issue create *)",
      "Bash(gh issue edit *)",
      "Bash(gh issue close *)",
      "Bash(gh issue reopen *)",
      "Bash(gh issue comment *)",
      "Bash(gh gist create *)",
      "Bash(gh workflow run *)",
      "Bash(gh secret set *)"
    ],
    "ask": [
      "Bash(npm publish *)",
      "Bash(pnpm publish *)",
      "Bash(cargo publish *)",
      "Bash(gh auth *)"
    ]
  },
  "model": "sonnet",
  "hooks": {
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/home/viscous/.config/claude/hooks/claude-notify.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/home/viscous/.config/claude/hooks/claude-notify.sh",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "/home/viscous/.config/claude/helpers/statusline.sh",
    "refreshInterval": 5
  },
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": true,
    "superpowers@claude-plugins-official": true,
    "rust-analyzer-lsp@claude-plugins-official": true
  },
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true,
    "allowUnsandboxedCommands": true,
    "network": {
      "allowedDomains": [
        "github.com",
        "*.github.com",
        "*.githubusercontent.com",
        "crates.io",
        "*.crates.io",
        "registry.npmjs.org",
        "*.npmjs.org",
        "nixos.org",
        "cache.nixos.org",
        "channels.nixos.org",
        "*.cachix.org",
        "pypi.org",
        "files.pythonhosted.org",
        "docs.rs",
        "*.rust-lang.org",
        "api.anthropic.com"
      ]
    },
    "filesystem": {
      "allowWrite": [
        "/persist/nixos-config"
      ]
    },
    "credentials": {
      "files": [
        {
          "path": "~/.ssh",
          "mode": "deny"
        },
        {
          "path": "~/.aws",
          "mode": "deny"
        },
        {
          "path": "~/.gnupg",
          "mode": "deny"
        }
      ],
      "envVars": [
        {
          "name": "NPM_TOKEN",
          "mode": "deny"
        },
        {
          "name": "CARGO_REGISTRY_TOKEN",
          "mode": "deny"
        },
        {
          "name": "PYPI_TOKEN",
          "mode": "deny"
        }
      ]
    },
    "excludedCommands": [
      "nixos-rebuild",
      "nix",
      "nix-store",
      "nix-env",
      "nix-collect-garbage",
      "home-manager",
      "systemctl",
      "sudo",
      "docker",
      "podman"
    ]
  },
  "tui": "fullscreen",
  "voice": {
    "enabled": true,
    "mode": "hold"
  },
  "skipDangerousModePermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "theme": "dark",
  "voiceEnabled": true,
  "advisorModel": "fable"
}
