/* Wallpaper effect picker with the current wallpaper as backdrop — WallpaperEffects.sh */
@import "~/.config/rofi/config.rasi"

window {
    width:  inherit;
    height: inherit;
}

mainbox {
    children: [ "inputbar", "listview" ];
}

inputbar {
    background-image: url("~/.cache/wallpaper-effects/preview.png", width);
}

entry {
    width:       32%;
    placeholder: " 🏙️ Search / Choose desired wallpaper effect";
}

listview {
    columns:      2;
    lines:        7;
    fixed-height: false;
    scrollbar:    true;
    spacing:      6px;
}

element-icon {
    size: 0%;
}
element-text {
    vertical-align: 0.0;
    margin:         0px;
    padding:        0px;
}
