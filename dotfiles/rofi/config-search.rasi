/* Web search prompt — RofiSearch.sh */
@import "~/.config/rofi/config.rasi"

window {
    width:        40%;
    height:       inherit;
    y-offset:     10px;
    location:     north;
    children:     [ "entry", "message" ];
    border:       2px;
    border-color: white/25%;
}

entry {
    expand:           true;
    placeholder:      " 🔎 Google Search";
    horizontal-align: 0.5;
    padding:          15px;
    border-radius:    inherit;
}
