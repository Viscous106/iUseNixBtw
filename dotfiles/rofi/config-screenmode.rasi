/* Screen comfort / media profiles — ScreenMode.sh */
@import "~/.config/rofi/config.rasi"

window {
    width:  42%;
    height: inherit;
}

mainbox {
    children: [ "inputbar", "listview" ];
}

entry {
    width:            43%;
    placeholder:      " 󰈈 Screen profile";
    horizontal-align: 0.5;
}

listview {
    lines:        7;
    fixed-height: false;
    margin:       10px;
}

element-icon {
    size: 0%;
}
element-text {
    margin: 5px 20px 5px 20px;
}
