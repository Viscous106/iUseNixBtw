  "model": "sonnet",
  "hooks": {
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/home/viscous/.config/claude/hooks/claude-notify.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/home/viscous/.config/claude/hooks/claude-notify.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/home/viscous/.config/tmux/scripts/agent-state.sh claude",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/home/viscous/.config/tmux/scripts/agent-state.sh claude",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/home/viscous/.config/tmux/scripts/agent-state.sh claude",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "/home/viscous/.config/claude/helpers/statusline.sh",
    "refreshInterval": 5
  },
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": true,
    "superpowers@claude-plugins-official": true,
    "rust-analyzer-lsp@claude-plugins-official": true
  },
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true,
    "allowUnsandboxedCommands": true,
    "network": {
      "allowedDomains": [
        "github.com",
        "*.github.com",
        "*.githubusercontent.com",
        "crates.io",
        "*.crates.io",
        "registry.npmjs.org",
        "*.npmjs.org",
        "nixos.org",
        "cache.nixos.org",
        "channels.nixos.org",
        "*.cachix.org",
        "pypi.org",
        "files.pythonhosted.org",
        "docs.rs",
        "*.rust-lang.org",
        "api.anthropic.com"
      ]
    },
    "filesystem": {
      "allowWrite": [
        "/persist/nixos-config"
      ]
    },
    "credentials": {
      "files": [
        {
          "path": "~/.ssh",
          "mode": "deny"
        },
        {
          "path": "~/.aws",
          "mode": "deny"
        },
        {
          "path": "~/.gnupg",
          "mode": "deny"
        }
      ],
      "envVars": [
        {
          "name": "NPM_TOKEN",
          "mode": "deny"
        },
        {
          "name": "CARGO_REGISTRY_TOKEN",
          "mode": "deny"
        },
        {
          "name": "PYPI_TOKEN",
          "mode": "deny"
        }
      ]
    },
    "excludedCommands": [
      "nixos-rebuild",
      "nix",
      "nix-store",
      "nix-env",
      "nix-collect-garbage",
      "home-manager",
      "systemctl",
      "sudo",
      "docker",
      "podman"
    ]
  },
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "high"
    }
  },
  "tui": "fullscreen",
  "voice": {
    "enabled": true,
    "mode": "hold"
  },
  "skipDangerousModePermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "theme": "auto",
  "autoMode": {
    "soft_deny": [
      "$defaults",
      "Bash(sshpass:*) — frequently used (250×) to drive non-interactive SSH/password auth; scope any carve-out narrowly and keep password-bearing invocations soft-blocked pending review"
    ],
